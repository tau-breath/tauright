# Browser
TAURIGHT_HEADED=0
PATCHRIGHT_CHANNEL=chrome
TAURIGHT_DEFAULT_SESSION=tau

# Persistent data. Leave unset to use the OS user-data directory:
# Windows: %LOCALAPPDATA%\TAURIGHT
# macOS:   ~/Library/Application Support/TAURIGHT
# Linux:   ~/.local/share/tauright
# TAURIGHT_DATA_ROOT=D:\path\to\tauright-data

# Optional overrides
# TAURIGHT_PROFILE_ROOT=D:\path\to\profiles
# TAURIGHT_RUNTIME_ROOT=D:\path\to\lanes
# TAURIGHT_STATE_ROOT=D:\path\to\state
# TAURIGHT_PROFILE=C:\path\to\one-existing-profile

# TAURIGHT releases pin a tested Patchright version.
# Dependency upgrades ship with TAURIGHT GitHub Releases rather than being fetched at startup.
