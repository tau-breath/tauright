{
    "name": "patchright",
    "version": "1.63.0",
    "description": "A high-level API to automate web browsers",
    "repository": {
        "type": "git",
        "url": "https://github.com/Kaliiiiiiiiii-Vinyzu/patchright"
    },
    "homepage": "https://github.com/Kaliiiiiiiiii-Vinyzu/patchright",
    "engines": {
        "node": ">=20"
    },
    "main": "index.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs",
            "require": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json",
        "./lib/common": "./lib/common/index.js",
        "./lib/program": "./lib/program.js",
        "./lib/runner": "./lib/runner/index.js",
        "./lib/transform/babelBundle": "./lib/transform/babelBundle.js",
        "./jsx-runtime": {
            "import": "./jsx-runtime.mjs",
            "require": "./jsx-runtime.js",
            "default": "./jsx-runtime.js"
        },
        "./lib/util": "./lib/util.js",
        "./types/test": {
            "types": "./types/test.d.ts"
        },
        "./types/testReporter": {
            "types": "./types/testReporter.d.ts"
        },
        "./test": {
            "types": "./test.d.ts",
            "import": "./test.mjs",
            "require": "./test.js",
            "default": "./test.js"
        }
    },
    "bin": {
        "patchright": "cli.js"
    },
    "author": {
        "name": "Microsoft Corportation, patched by github.com/Kaliiiiiiiiii-Vinyzu/"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "patchright-core": "1.63.0"
    }
}